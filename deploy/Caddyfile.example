# The hostname must resolve to the server before Caddy can obtain a certificate.
# For this deployment use jobs.cupdky.cn and keep APP_BASE_URL identical.
# Caddy obtains and renews the certificate automatically when DNS and firewall
# rules point the hostname at this server.
jobs.cupdky.cn {
    encode gzip

    # Caddy runs beside the web service on the Compose network.
    reverse_proxy web:8080 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }
}
