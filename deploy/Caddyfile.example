# The formal hostname must resolve to the server before Caddy can obtain a
# certificate. Caddy obtains and renews it automatically after DNS is live.
(job_hub_proxy) {
    encode gzip

    reverse_proxy web:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }
}

# Formal public hostname. Keep APP_BASE_URL identical to this hostname.
jobs.cupdky.cn {
    import job_hub_proxy
}

# Temporary access endpoint before the formal domain resolves. It is HTTP only
# and must not be used in public materials because it has no TLS certificate.
http://81.70.62.174 {
    import job_hub_proxy
}
