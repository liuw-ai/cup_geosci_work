# The formal hostname must resolve to the server before Caddy can obtain a
# certificate. Caddy obtains and renews it automatically after DNS is live.
(job_hub_proxy) {
    encode gzip

    reverse_proxy web:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }
}

# Formal public hostname. Keep APP_BASE_URL identical to this hostname.
cupgeojob.com {
    import job_hub_proxy
}

www.cupgeojob.com {
    redir https://cupgeojob.com{uri} 308
}

# Temporary diagnostic endpoint before the formal domain resolves. Never proxy
# the application over plaintext: redirect every IP request to the formal
# HTTPS hostname so administrator credentials cannot be submitted over HTTP.
http://81.70.62.174 {
    redir https://cupgeojob.com{uri} 308
}
