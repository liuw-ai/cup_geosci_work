ARG RUNTIME_IMAGE=cupb-geoscience-job-hub:latest
# Reuse a verified browser dependency layer during release builds. This keeps
# Playwright construction independent of transient PyPI network failures while
# the final image remains based on the pinned application runtime image.
ARG BROWSER_DEPS_IMAGE=cupb-geoscience-job-hub-browser:bd61c09-general
FROM ${BROWSER_DEPS_IMAGE} AS browser-deps
FROM ${RUNTIME_IMAGE}

# The public web/worker image deliberately has no browser client.  This image
# is built only for the isolated read-only browser workers, which connect to
# the internal headless-shell CDP service.  Installing the Python client at
# image build time makes startup independent of PyPI availability and keeps a
# failed browser dependency from being mistaken for an official-source scan
# result.
USER root
ARG INSTALL_BROWSER_DEPS=1
# job.sinopec.com's IPv4 endpoint currently omits its public GlobalSign
# intermediate. Add the independently downloaded, pinned intermediate to the
# normal system trust store; TLS verification remains enabled.
COPY deploy/certs/gsrsaovsslca2018.crt /usr/local/share/ca-certificates/gsrsaovsslca2018.crt
RUN update-ca-certificates
COPY requirements-browser.txt /tmp/requirements-browser.txt
COPY --from=browser-deps /usr/local/lib/python3.11/site-packages/playwright /usr/local/lib/python3.11/site-packages/playwright
COPY --from=browser-deps /usr/local/lib/python3.11/site-packages/playwright-1.48.0.dist-info /usr/local/lib/python3.11/site-packages/playwright-1.48.0.dist-info
COPY --from=browser-deps /usr/local/lib/python3.11/site-packages/pyee /usr/local/lib/python3.11/site-packages/pyee
COPY --from=browser-deps /usr/local/lib/python3.11/site-packages/pyee-12.0.0.dist-info /usr/local/lib/python3.11/site-packages/pyee-12.0.0.dist-info
COPY --from=browser-deps /usr/local/lib/python3.11/site-packages/greenlet /usr/local/lib/python3.11/site-packages/greenlet
COPY --from=browser-deps /usr/local/lib/python3.11/site-packages/greenlet-3.1.1.dist-info /usr/local/lib/python3.11/site-packages/greenlet-3.1.1.dist-info
COPY --from=browser-deps /usr/local/lib/python3.11/site-packages/bs4 /usr/local/lib/python3.11/site-packages/bs4
COPY --from=browser-deps /usr/local/lib/python3.11/site-packages/beautifulsoup4-4.12.3.dist-info /usr/local/lib/python3.11/site-packages/beautifulsoup4-4.12.3.dist-info
COPY --from=browser-deps /usr/local/lib/python3.11/site-packages/soupsieve /usr/local/lib/python3.11/site-packages/soupsieve
COPY --from=browser-deps /usr/local/lib/python3.11/site-packages/soupsieve-2.10.dist-info /usr/local/lib/python3.11/site-packages/soupsieve-2.10.dist-info
COPY --from=browser-deps /usr/local/lib/python3.11/site-packages/typing_extensions.py /usr/local/lib/python3.11/site-packages/typing_extensions.py
COPY --from=browser-deps /usr/local/lib/python3.11/site-packages/typing_extensions-4.16.0.dist-info /usr/local/lib/python3.11/site-packages/typing_extensions-4.16.0.dist-info
# Validate the copied, pinned dependency layer without reaching PyPI.  The
# packages and dist-info are copied above from the immutable browser-deps
# image; pip's no-index check catches a missing or incompatible package while
# keeping release builds reproducible when the network is unavailable.
RUN pip install --no-cache-dir --no-index --no-deps -r /tmp/requirements-browser.txt
# Copy only the generic browser contracts and dispatcher. The base runtime
# image already contains the coherent application package; copying the whole
# worktree here can combine a newer pipeline module with older dependencies
# when a server workspace is being updated incrementally.
COPY --chown=jobhub:jobhub job_hub/browser_capture.py /app/job_hub/browser_capture.py
COPY --chown=jobhub:jobhub job_hub/browser_timeout.py /app/job_hub/browser_timeout.py
COPY --chown=jobhub:jobhub job_hub/official_browser_worker.py /app/job_hub/official_browser_worker.py
COPY --chown=jobhub:jobhub job_hub/cnpc_browser_worker.py /app/job_hub/cnpc_browser_worker.py
COPY --chown=jobhub:jobhub job_hub/cmgb_browser_worker.py /app/job_hub/cmgb_browser_worker.py
COPY --chown=jobhub:jobhub job_hub/cupb_browser_worker.py /app/job_hub/cupb_browser_worker.py
COPY --chown=jobhub:jobhub job_hub/cnooc_browser_worker.py /app/job_hub/cnooc_browser_worker.py
COPY --chown=jobhub:jobhub job_hub/sinopec_browser_worker.py /app/job_hub/sinopec_browser_worker.py
COPY --chown=jobhub:jobhub job_hub/iguopin_browser_worker.py /app/job_hub/iguopin_browser_worker.py
COPY --chown=jobhub:jobhub job_hub/cnpc_browser_entrypoint.py /app/job_hub/cnpc_browser_entrypoint.py
COPY --chown=jobhub:jobhub job_hub/cmgb_browser_capture.py /app/job_hub/cmgb_browser_capture.py
COPY --chown=jobhub:jobhub job_hub/iguopin_browser_capture.py /app/job_hub/iguopin_browser_capture.py
COPY --chown=jobhub:jobhub job_hub/browser_watchdog.py /app/job_hub/browser_watchdog.py
USER jobhub

CMD ["python", "-m", "job_hub.cnpc_browser_entrypoint"]
