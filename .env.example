# Public site
SITE_NAME=地学就业信息站
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_BASE_URL=https://jobs.example.edu.cn
APP_TIMEZONE=Asia/Shanghai
# Local development defaults. Docker Compose overrides both paths to its named volume.
APP_DATA_DIR=runtime
APP_DATABASE_PATH=runtime/job_hub.sqlite3

# Scheduler
# The worker collects source updates throughout the day and publishes the frozen
# daily report at this local time.
DAILY_PUBLISH_TIME=20:00
SOURCE_SYNC_INTERVAL_MINUTES=180
# A run left in "running" beyond this interval is marked interrupted before syncing.
CRAWL_RUN_STALE_SECONDS=1800
MAX_SOURCE_ITEMS=40
REQUEST_TIMEOUT_SECONDS=20

# Admin endpoint. Keep this private and never commit a real value.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Email notification. Set MAIL_ENABLED=true only after SMTP is configured.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=jobs@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM=jobs@example.com
SMTP_TO=your-address@example.com
SMTP_USE_SSL=true
