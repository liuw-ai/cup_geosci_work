# Public site
SITE_NAME=地学就业信息站
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_BASE_URL=https://jobs.example.edu.cn
APP_TIMEZONE=Asia/Shanghai
# Local development defaults. Docker Compose overrides both paths to its named volume.
APP_DATA_DIR=runtime
APP_DATABASE_PATH=runtime/job_hub.sqlite3

# Scheduler
# The worker collects source updates throughout the day and publishes the frozen
# daily report at this local time.
DAILY_PUBLISH_TIME=20:00
SOURCE_SYNC_INTERVAL_MINUTES=180
# A run left in "running" beyond this interval is marked interrupted before syncing.
CRAWL_RUN_STALE_SECONDS=1800
MAX_SOURCE_ITEMS=80
REQUEST_TIMEOUT_SECONDS=20
# Versioned official PDF/Excel manifest. The worker registers it automatically
# on every sync; leave the default path when running from the repository image.
GOVERNMENT_ARTIFACT_MANIFEST_PATH=data/government_artifact_manifest.json
GOVERNMENT_POSITION_REGISTRY_PATH=data/government_position_registry.json
# Outbound HTTP policy: environment honors HTTP(S)_PROXY/ALL_PROXY;
# direct ignores those variables for public-source requests on a server with
# approved direct egress. Never disable TLS verification to fix a probe error.
HTTP_TRANSPORT_MODE=environment

# Official announcement attachments. Files remain private below APP_DATA_DIR;
# student pages never serve this directory. OCR is disabled unless explicitly enabled.
# Relative to APP_DATA_DIR (use an absolute path only when it is still inside APP_DATA_DIR).
ATTACHMENT_STORAGE_DIR=official-attachments
ATTACHMENT_MAX_BYTES=25000000
ATTACHMENT_DISCOVERY_MAX_BYTES=2000000
ATTACHMENT_MAX_ROWS=2000
ATTACHMENT_MAX_TEXT_CHARACTERS=250000
ATTACHMENT_OCR_ENABLED=false
ATTACHMENT_OCR_LANGUAGE=chi_sim+eng
ATTACHMENT_OCR_MAX_PAGES=12

# Admin endpoint. Keep this private and never commit a real value.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Email notification. Set MAIL_ENABLED=true only after SMTP is configured.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=jobs@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM=jobs@example.com
SMTP_TO=your-address@example.com
SMTP_USE_SSL=true
